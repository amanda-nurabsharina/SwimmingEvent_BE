# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (BE_SE)
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production
PORT=8080

# Database Configuration:
# For SQLite (standalone):
#   DB_DRIVER=sqlite
# For PostgreSQL (Docker / Production server):
#   DB_DRIVER=postgres
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=swimming_event
DB_SSLMODE=disable

# Security Configuration
API_SECRET_KEY=secret-swimming-api-key-2026
JWT_SECRET=swimming-jwt-super-secret-key-change-in-production

# CORS Allowed Origins (Comma-separated domains or * for public APIs)
# Example Production: https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
